// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  Boolean   @default(false)
  image          String?
  role           Role      @default(CUSTOMER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  banned         Boolean?
  banReason      String?
  banExpires     DateTime?
  sessions       Session[]
  accounts       Account[]
  phoneNumber    String?
  whatsappNumber String?
  fullAddress    String?

  cart   Cart?
  orders Order[]
}

enum Role {
  ADMIN
  CUSTOMER
  MODERATOR
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([accessToken])
  @@index([refreshToken])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Product {
  id    String  @id @default(cuid())
  title String
  slug  String  @unique
  sku   String? @unique // Added: Unique identifier for warehouse packing
  brand String? // Changed: Made optional for unbranded raw items

  unit String? // Added: e.g., "500 gm", "1 Kg", "1 Liter", "12 pcs"

  price              Float
  discountPercentage Float @default(0)

  shortDescription String?
  productDetails   String? @db.Text

  isAvailable Boolean @default(true)
  isBestDeal  Boolean @default(false)
  isPopular   Boolean @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  priority Int @default(0) // Added: For sorting products in the UI

  campaigns  Campaign[]
  orderItems OrderItem[]
  cartItems  CartItem[]
  images     ProductImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id       String @id @default(cuid())
  slug     String @unique // e.g., "eid-special-honey"
  headline String // Big, catchy title for the landing page

  campaignPrice  Float // The special price just for this campaign
  deliveryCharge Float @default(0) // Sometimes campaigns offer "Free Delivery"

  videoUrl    String? // A specific marketing video for this campaign
  description String? @db.Text // Long-form sales copy

  isActive Boolean   @default(false)
  endDate  DateTime? // Optional: If you want to show a "Sale ends in X days" countdown timer

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId], name: "cartId_productId")
}

model Order {
  id      String @id @default(cuid())
  orderId String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  customerName   String
  emailAddress   String
  phoneNumber    String
  whatsappNumber String?
  fullAddress    String

  status             OrderStatus   @default(PENDING)
  orderPaymentMethod PaymentMethod @default(CASH_ON_DELIVERY)
  TrxNumber          String?
  TrxID              String?

  shippingCost Float @default(0)
  discount     Float @default(0)

  productCost  Float?
  deliveryCost Float?

  orderItems OrderItem[]
  payments   Payment[]
  notes      Note[]

  orderDate DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName        String
  productImage       String? // Snapshot of the main image at checkout
  quantity           Int
  price              Float // Snapshot of the base price at checkout
  discountPercentage Float   @default(0) // Snapshot of the discount at checkout

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount Float
  method PaymentMethod
  date   DateTime      @default(now())
  note   String?
}

model Note {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  image    String? // Added for category card UI
  priority Int     @default(0) // Added for sorting categories in the UI

  products Product[]
}

model ProductImage {
  id         String  @id @default(cuid())
  imageId    String
  url        String
  isFeatured Boolean @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BKASH
  NAGAD
  ROCKET
  BANK_TRANSFER
  CARD
  OTHER
}

model ContactSubmission {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String        @db.Text
  status    ContactStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum ContactStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}
